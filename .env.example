# Copy to .env (never commit it). Generate the key with: mammo-triage new-key
MAMMO_MODELS_DIR=C:\path\to\bundles\v1
MAMMO_API_KEY=
MAMMO_DEVICE=auto
MAMMO_HOST=127.0.0.1
MAMMO_PORT=8765
MAMMO_MAX_IMAGE_MB=10
MAMMO_RATE_LIMIT_PER_MINUTE=60
MAMMO_ALLOWED_ORIGINS=http://localhost:5173
MAMMO_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
MAMMO_TRUST_PROXY_HEADERS=false
